pkgname=basalt-branding
pkgver=0.1.0
pkgrel=1
pkgdesc="BasaltOS text identity and console branding templates"
arch=('any')
url="https://github.com/basaltos-team/packages"
license=('MIT')
options=('!debug')

package() {
  install -Dm644 "$startdir/files/usr/share/basalt/branding/os-release" "$pkgdir/usr/share/basalt/branding/os-release"
  install -Dm644 "$startdir/files/usr/share/basalt/branding/issue" "$pkgdir/usr/share/basalt/branding/issue"
  install -Dm644 "$startdir/files/usr/share/basalt/branding/name" "$pkgdir/usr/share/basalt/branding/name"
}
